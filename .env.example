# Spotify — https://developer.spotify.com/dashboard → your app → Settings
# Redirect URIs (exact match), e.g. http://localhost:5173/callback and your Vercel /callback
VITE_SPOTIFY_CLIENT_ID=
# Optional in dev (auto-detected from browser). Production: your Vercel URL /callback
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback
# Server-only — used for search via client credentials (never expose to the browser)
SPOTIFY_CLIENT_SECRET=
# Optional alias for local server; falls back to VITE_SPOTIFY_CLIENT_ID
# SPOTIFY_CLIENT_ID=

# Production site URL (for invite links when sharing from local dev). On Vercel, set to:
# https://your-app.vercel.app
VITE_APP_URL=

# Firebase (Realtime Database multiplayer)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Legacy optional REST game API (unused when Firebase is configured)
VITE_GAME_API=

# Apple Music / MusicKit — server-side only (never expose the .p8 key to the browser)
# Used by GET /api/musickit-token (local: http://localhost:3000/api/musickit-token)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the full .p8 contents; use \n for line breaks in one line
APPLE_PRIVATE_KEY=
# Aliases also supported:
# APPLE_MUSIC_TEAM_ID=  APPLE_MUSIC_KEY_ID=  APPLE_MUSIC_PRIVATE_KEY=
# Optional web origin claim (apple-music/developer-token route only):
# APPLE_MUSIC_ORIGIN=http://localhost:5173
