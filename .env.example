# Copy to `.env` or `.env.local` and fill in your Spotify app values.
# Dashboard: https://developer.spotify.com/dashboard — add the same Redirect URI.
#
# Spotify does not allow the hostname "localhost". Use loopback IP:
#   http://127.0.0.1:PORT/callback   or   http://[::1]:PORT/callback

VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Firebase (Realtime Database multiplayer)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Legacy optional REST game API (unused when Firebase is configured)
VITE_GAME_API=
