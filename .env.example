# Spotify — https://developer.spotify.com/dashboard → your app → Settings → Redirect URIs
# Add EVERY URL you use locally (Spotify requires an exact match), e.g.:
#   http://localhost:5173/callback
#   http://127.0.0.1:5173/callback
# Production (Vercel): https://your-app.vercel.app/callback
VITE_SPOTIFY_CLIENT_ID=
# Optional in dev (auto-detected from browser). Production: your Vercel URL /callback
# Do NOT use 127.0.0.1 here on Vercel — it sends users to your laptop.
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Production site URL (for invite links when sharing from local dev). On Vercel, set to:
# https://your-app.vercel.app
VITE_APP_URL=

# Firebase (Realtime Database multiplayer)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Legacy optional REST game API (unused when Firebase is configured)
VITE_GAME_API=
