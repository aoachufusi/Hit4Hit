# EXPO_PUBLIC_* are embedded in the JS bundle — safe for Firebase client config.
# Use the same Firebase project as web (hit4hit.app).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Public web origin for invite links + music search API
EXPO_PUBLIC_APP_URL=https://hit4hit.app
# Optional override if API is hosted separately
# EXPO_PUBLIC_API_URL=https://hit4hit.app

# Spotify App Remote (react-native-spotify-remote) — host full playback
# Create an app at https://developer.spotify.com/dashboard
# Redirect URI must match: hit4hit://spotify-callback
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_REDIRECT_URL=hit4hit://spotify-callback
# Optional token swap/refresh server (required by Spotify iOS SDK auth flow)
EXPO_PUBLIC_SPOTIFY_TOKEN_SWAP_URL=
EXPO_PUBLIC_SPOTIFY_TOKEN_REFRESH_URL=
