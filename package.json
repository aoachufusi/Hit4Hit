{
  "name": "hit-for-hit",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "web",
    "shared",
    "ios"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:all": "npm run dev:all --workspace=web",
    "server": "npm run server --workspace=web",
